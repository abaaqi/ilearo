{
  "name": "ile-aro-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Online shop for hand-dyed adire: Next.js, Postgres (Supabase or Neon), Google sign-in and Mailgun order emails.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "tsx scripts/db-setup.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test --project=chromium",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:app-web": "node scripts/build-app-web.mjs",
    "test:app": "next build && node scripts/build-app-web.mjs && playwright test --project=app-in-browser"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-stencil": "^5.3.0",
    "@fontsource-variable/commissioner": "^5.3.0",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
