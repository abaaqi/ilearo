# Copy this file to .env.local for local development, and add the same
# variables to your host (for example Vercel → Project → Settings →
# Environment Variables) for production.

# The public address of the site, without a trailing slash. Used to build the
# Google sign-in redirect URL and the links inside emails.
APP_URL=http://localhost:3000

# Postgres connection string from Supabase or Neon (any Postgres works).
#   Supabase: Connect → Connection string → "Transaction pooler" (port 6543)
#   Neon:     Connect → enable "Connection pooling" and copy the URL
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ile_aro

# Google sign-in: Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (type "Web application"). Add this authorized redirect URI:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun: Sending → Domain settings → Sending API keys.
# If any of these are empty, emails are written to the server log instead.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Ile Aro <orders@mg.example.com>"
# "us" for api.mailgun.net or "eu" for api.eu.mailgun.net. Match the region
# your Mailgun domain was created in.
MAILGUN_REGION=us

# Where customers can reach you. Shown on the site and used as the email
# Reply-To address.
SHOP_SUPPORT_EMAIL=hello@example.com

# Optional. Fill in all three to offer "Bank transfer" at checkout; leave them
# empty and checkout offers pay on delivery only.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
